# Generated narration - rebuild with python -m src.tts.generate_audio
# Audio/ and Sound/ are the two audio directory names the bundled models use
# (see src/tts/model_audio.py generated_path()); a model using a third name
# would leak its generated WAVs into `git status`.
models/*/Audio/tts/
models/*/Sound/tts/
